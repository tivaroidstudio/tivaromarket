{
  "name": "tivaromarket",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"packages/*/test/*.test.ts\" \"apps/worker/test/*.test.ts\" \"apps/mcp/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "worker": "node --disable-warning=ExperimentalWarning apps/worker/src/main.ts",
    "mcp": "node --disable-warning=ExperimentalWarning apps/mcp/src/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning apps/worker/src/demo.ts",
    "dev:web": "pnpm --filter @tivaro/web dev",
    "build:web": "pnpm --filter @tivaro/web build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
